# 环境变量示例（本地开发 / 手动 docker run 参考）。
# 容器内 BLOB_ROOT 固定为 /data/blobs。

DATABASE_URL=postgresql://serenique:serenique@127.0.0.1:5432/serenique
BLOB_MAX_SIZE=104857600

# Optional for normal uploads/downloads, required for signed blob access links.
# Use at least 32 random characters.
BLOB_SIGNING_SECRET=change-me-change-me-change-me-change-me

# --- Passkey 认证（见 .ai/requirements/2026-08-09-passkey-auth.md）---
# 会话 Cookie 签名密钥（≥32 字符）。生产缺失则 API 拒绝启动（fail-closed）。
# 换掉它并重启 = 所有 Web 会话失效（无状态 HMAC cookie）。
SESSION_SECRET=change-me-change-me-change-me-change-me

# 引导注册令牌（≥32 字符）：凭证计数为 0（引导期）时，注册必须携带它
# （常量时间比对）。部署后首个凭证创建完成即可从 env 移除（生产不强制保留）。
SETUP_TOKEN=change-me-change-me-change-me-change-me

# 引导脚本 FIRST_USER_*（可选）：bun scripts/bootstrap-user.ts 创建首个用户时
# 的默认值（命令行 --name/--email/--birthday 参数优先）。users 行只由该脚本
# 创建——注册接口不再创建用户（见 .ai/requirements/2026-08-09-passkey-auth.md 决策⑨）。
# FIRST_USER_NAME=张三
# FIRST_USER_EMAIL=me@example.com
# FIRST_USER_BIRTHDAY=1990-01-01

# WebAuthn RP ID = 前端域名（不是 API 域名！），如 serenique-web.pages.dev；
# 本地开发用 localhost。⚠️ 换前端域名 = 已注册的 passkey 全部失效。
# 生产缺失则 API 拒绝启动；未配置（本地开发）则认证整体跳过。
WEBAUTHN_RP_ID=localhost

# RP 展示名（浏览器 passkey 弹窗显示），默认 "Serenique"。
# WEBAUTHN_RP_NAME=Serenique

# 允许的 WebAuthn origin（逗号分隔，ceremony 白名单）。默认本地开发端口。
WEBAUTHN_ORIGINS=http://localhost:5173,http://localhost:3000

# Web 会话 Cookie 有效期（秒），默认 30 天。
# SESSION_TTL=2592000

# 服务端审计日志保留策略：保留天数 / 最大条数，超出的由后台定时清扫删除。
# 缺省 90 天 / 5000 条。
# AUDIT_RETENTION_DAYS=90
# AUDIT_MAX_ROWS=5000

# 生产 CORS：设为 Web 前端真实域名（示例 https://example.com，部署时替换）。
# 带凭证（Cookie）的跨域请求不允许 origin 为 "*"，未设/设错时浏览器会拦截登录。
# 注意：origin 不含路径与结尾斜杠；必须与浏览器 Origin 头完全一致（含协议）。
CORS_ORIGIN=https://example.com

# --- Web (apps/web) ---
# Build-time env for the Vite app. Left empty, the app calls /api/* on the same
# origin (dev: Vite proxy -> localhost:3000; prod: reverse proxy). Override only
# when the API is served from a different origin, e.g. http://10.126.126.2:3000.
# VITE_API_BASE_URL=http://10.126.126.2:3000

# ---- AI 助手（宁序）----
# NewAPI 网关凭据/端点：显式配置时优先生成 env 驱动 models.json，
# 覆盖 ~/.pi 用户级配置；都不配则 AI 按未配置停用
AI_BASE_URL=
AI_API_KEY=
# 模型选择 "provider/modelId"（缺省 newapi/ox-alpha；换模型 = 只改这里，无需改代码）
AI_MODEL=
# 单模型的上下文窗口/最大输出 token 兜底（可选，默认 1048576 / 131072）
AI_CONTEXT_WINDOW=
AI_MAX_TOKENS=
# AI 会话目录（缺省：生产 /data/sessions，dev ./.data/sessions）
AI_SESSION_DIR=

# ---- 安全中间件（hono 内置 + hono-rate-limiter，均有默认值，无需配置）----
# 速率限制：60s 窗口内每 IP 最大请求数（默认 100，单用户场景很宽松）。
# /health 与 NODE_ENV=test 自动豁免。
# RATE_LIMIT_MAX=100
# 请求体上限（字节，默认 100MB）。运行时自动取 max(本值, BLOB_MAX_SIZE + 1MB)，
# 保证 100MB blob 上传不被误杀。
# BODY_LIMIT_MAX_SIZE=104857600
# 请求处理超时（毫秒，默认 60s）。/api/ai/*（WebSocket 流式）自动豁免。
# HTTP_TIMEOUT_MS=60000

# ---- 位置服务（高德 Web 服务代理）----
# 高德 Web 服务 Key（未配置 → /api/location/config 返回 enabled=false，
# nearby/search 返回 503「位置服务未配置」）。申请：https://console.amap.com
AMAP_KEY=
