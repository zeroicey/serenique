# Docker Compose reads this file from the project root.
# BLOB_ROOT is fixed to /data/blobs inside the containers.

DATABASE_URL=postgresql://serenique:serenique@127.0.0.1:5432/serenique
BLOB_MAX_SIZE=104857600

# Optional for normal uploads/downloads, required for signed blob access links.
# Use at least 32 random characters.
BLOB_SIGNING_SECRET=change-me-change-me-change-me-change-me

# Optional: host-reachable base URL the MCP service embeds in `upload_blob`
# curl examples. Defaults to http://localhost:3000 in docker-compose (the
# published API port); override only if the API is reachable at a different
# address on your host (LAN IP, custom port, etc.).
# SERENIQUE_PUBLIC_API_BASE_URL=http://localhost:3000
