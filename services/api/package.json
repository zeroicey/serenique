{
  "name": "@serenique/api",
  "exports": {
    ".": "./src/exports.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "test:integration": "RUN_DB_TESTS=1 bun test src/modules/*/*.integration.test.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:db:migrate": "DATABASE_URL=postgresql://serenique:serenique@127.0.0.1:5432/serenique bun run db:migrate",
    "test:integration:full": "docker compose -f docker-compose.test.yml up -d --wait && DATABASE_URL=postgresql://serenique:serenique@127.0.0.1:5432/serenique bun run db:migrate && RUN_DB_TESTS=1 bun test src/modules/*/*.integration.test.ts; docker compose -f docker-compose.test.yml down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@simplewebauthn/server": "^13.3.2",
    "@smithy/node-http-handler": "^4.11.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "hono-rate-limiter": "^0.5.3",
    "https-proxy-agent": "^9.1.0",
    "pino": "^10.3.1",
    "pinyin-pro": "^3.28.2",
    "postgres": "^3.4.9",
    "sharp": "^0.35.3",
    "typebox": "1.3.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3"
  }
}
